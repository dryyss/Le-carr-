# Base de données (Neon via Vercel en prod ; docker compose en local)
# L'intégration Neon de Vercel fournit DATABASE_URL : l'un ou l'autre suffit.
DATABASE_URI=postgres://lecarre:lecarre@127.0.0.1:5433/lecarre
# Chaîne aléatoire longue : openssl rand -hex 32
PAYLOAD_SECRET=
# Facultatif sur Vercel (déduit du domaine de production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mode démo : aucun SMS / mail / paiement réel, code de connexion affiché, comptes de démo
DEMO_MODE=true

# SMS (Brevo)
BREVO_API_KEY=
SMS_SENDER=LECARRE

# Mails (Resend)
MAIL_FROM=
RESEND_API_KEY=

# Paiement en ligne (Stripe Checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stockage des médias (Vercel Blob). Vide en local : fichiers stockés sur disque.
BLOB_READ_WRITE_TOKEN=

# Protège les routes /api/cron/*
CRON_SECRET=

# Seed hors mode démo : mots de passe des comptes. Générés au hasard si vides.
SEED_GERANT_PASSWORD=
SEED_SERVEUR_PASSWORD=
